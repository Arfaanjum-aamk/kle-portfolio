# Public values only. Never put a service-role key, SMTP credentials or any other secret here.
# Find these in Supabase: Project Settings -> API (Project URL and publishable / anon key).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY

# Comma-separated list of email domains allowed to register. Leave empty to allow any domain.
# Example: VITE_ALLOWED_EMAIL_DOMAINS=kletech.ac.in
# This is a UX convenience only; enforce it server-side too (see README, "Email domain restriction").
VITE_ALLOWED_EMAIL_DOMAINS=

# Base path for GitHub Pages project sites. The deploy workflow sets this automatically
# to "/<repository-name>/". Use "/" for local development.
VITE_BASE_PATH=/
